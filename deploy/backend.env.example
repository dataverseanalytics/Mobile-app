# Backend secrets for production. ENV, DATABASE_URL and CORS_ORIGINS are set
# by docker-compose.yml. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ADMIN_JWT_SECRET=
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=

# OTP SMS (APITxT)
SMS_PROVIDER=apitxt
APITXT_AUTH_KEY=
# APITXT_TEMPLATE_ID=42   (your DLT-approved template id)
# App Store / Play review login only (always accepts OTP_TEST_CODE):
OTP_TEST_NUMBERS=[]

# AI (OpenAI)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_REASONING_EFFORT=low

# Payments (Razorpay live keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
