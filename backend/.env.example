# Local development settings (do not commit real secrets).
ENV=development
DATABASE_URL=postgresql+asyncpg://nutrilens:nutrilens@localhost:5434/nutrilens
JWT_SECRET=dev-only-jwt-secret-change-me-please
ADMIN_JWT_SECRET=dev-only-admin-secret-change-me-please
SMS_PROVIDER=console
AI_PROVIDER=mock
OTP_TEST_NUMBERS=["+15005550006"]
CORS_ORIGINS=["http://localhost:3000"]
ADMIN_EMAIL=admin@nutrilens.app
ADMIN_PASSWORD=ChangeMe123!

# Production: generate long random secrets, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Real OTP SMS via APITxT (apitxt.com → Dashboard → API Keys):
# SMS_PROVIDER=apitxt
# APITXT_AUTH_KEY=...
# APITXT_TEMPLATE_ID=42        (optional: your SMS template id; blank = APITxT default)
# APITXT_CHANNEL=sms           (sms | whatsapp | voice)
# Or SMS worldwide via Twilio:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_VERIFY_SERVICE_SID=MG...   (Messaging Service SID)
# Real AI (photo scan, meal descriptions, suggestions) with OpenAI:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5             (vision model for meal photos)
# OPENAI_TEXT_MODEL=gpt-5.4-mini   (text model: descriptions, suggestions)
# OPENAI_REASONING_EFFORT=low     (reasoning models only; empty for gpt-4.1/gpt-4o)
# Payments with Razorpay (Dashboard → Account & Settings → API Keys):
# RAZORPAY_KEY_ID=rzp_test_...        (use rzp_live_... in production)
# RAZORPAY_KEY_SECRET=...
# Dashboard → Webhooks → URL https://<api>/v1/webhooks/razorpay,
# events payment.captured, order.paid, payment.failed:
# RAZORPAY_WEBHOOK_SECRET=...
